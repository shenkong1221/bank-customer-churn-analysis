      <column caption='age_group' datatype='string' name='[Calculation_2697171236589569]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt; 30 THEN &quot;Under 30&quot;&#10;ELSEIF [age] &gt;= 30 AND [age] &lt;= 50 THEN &quot;30-50&quot;&#10;ELSE &quot;50+&quot;&#10;END' />
